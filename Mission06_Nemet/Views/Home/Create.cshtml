@{
}

@model Movie

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="Category">Category:</label>
        <select asp-for="Category">
            <option value="Action">Action</option>
            <option value="Comedy">Comedy</option>
            <option value="Drama">Drama</option>
            <option value="Horror">Horror</option>
            <option value="SciFi">Sci-Fi</option>
            <option value="Romance">Romance</option>
            <option value="Documentary">Documentary</option>
        </select>
    </div>

    <div>
        <label asp-for="Title">Title:</label>
        <input type="text" asp-for="Title" required />
    </div>

    <div>
        <label asp-for="Year">Year:</label>
        <input type="number" asp-for="Year" required />
    </div>

    <div>
        <label asp-for="Director">Director:</label>
        <input type="text" asp-for="Director" required />
    </div>

    <div>
        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating">
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <div>
        <label>Edited:</label><br />

        <input type="radio" asp-for="Edited" value="true" id="editedYes" />
        <label for="editedYes">Yes</label>

        <input type="radio" asp-for="Edited" value="false" id="editedNo" />
        <label for="editedNo">No</label>
    </div>


    <div>
        <label asp-for="LentTo">Lent To (Optional):</label>
        <input type="text" asp-for="LentTo" />
    </div>

    <div>
        <label asp-for="Notes">Notes (Max 25 characters, Optional):</label>
        <input type="text" asp-for="Notes" maxlength="25" />
    </div>

    <button type="submit">Add Movie</button>
</form>
